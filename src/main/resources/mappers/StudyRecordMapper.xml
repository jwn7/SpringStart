<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.springstart.study.repository.StudyRecordMapper">

    <resultMap id="studyRecordResultMap" type="com.springstart.study.domain.StudyRecord">
        <id column="id" property="id"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="study_minutes" property="studyMinutes"/>
    </resultMap>
    <select id="findById" resultMap="studyRecordResultMap">
        SELECT id, title, content, study_minutes
        FROM study_records
        WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="studyRecordResultMap">
        SELECT id, title, content, study_minutes
        FROM study_records
        ORDER BY id ASC
    </select>

    <select id="findByMinStudyMinutes" parameterType="int" resultMap="studyRecordResultMap">
        SELECT id, title, content, study_minutes
        FROM study_records
        WHERE study_minutes >= #{minStudyMinutes}
        ORDER BY id ASC
    </select>
</mapper>