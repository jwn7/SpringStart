<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.springstart.study.repository.StudyRecordMapper">

    <select id="findById" resultType="com.springstart.study.domain.StudyRecord">
        SELECT id, title, content, study_minutes
        FROM study_records
        WHERE id = #{id}
    </select>

    <select id="findAll" resultType="com.springstart.study.domain.StudyRecord">
        SELECT id, title, content, study_minutes
        FROM study_records
        ORDER BY id ASC
    </select>
</mapper>